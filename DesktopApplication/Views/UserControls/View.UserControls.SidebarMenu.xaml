<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsSidebarMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DesktopApplication.Services.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d">
    <Border Background="{StaticResource MaterialDesignShadowBrush}">
        <Grid Margin="20,10" MinHeight="650">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,50">
                <Image Source="/Assets/Icons/Logo.ico" Width="60"/>
                <TextBlock
                    Text="Journal" 
                    FontSize="52" FontFamily="{StaticResource Caveat}" FontWeight="Bold"
                    Foreground="White"
                    Margin="15, 0, 0, 0"
                    />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,50">
                <Border CornerRadius="50"
                        Width="96" Height="96"
                        Margin="0,0,0,20">
                    <Border.Background>
                        <ImageBrush Stretch="Fill">
                            <ImageBrush.ImageSource>
                                <Binding Path="ModelUser.AvatarUrl">
                                    <Binding.Converter>
                                        <converters:ServicesConvertersUriValidationConverter/>
                                    </Binding.Converter>
                                    <Binding.FallbackValue>
                                        <BitmapImage UriSource="/Assets/Avatars/DefaultAvatar.png"/>
                                    </Binding.FallbackValue>
                                    <Binding.TargetNullValue>
                                        <BitmapImage UriSource="/Assets/Avatars/DefaultAvatar.png"/>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>

                <TextBlock 
                    Text="{Binding ModelUser.FullName, FallbackValue='No data available', TargetNullValue='No data available'}"
                    FontSize="24" 
                    FontFamily="{StaticResource Roboto}"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>
                <TextBlock
                    Text="{Binding ModelUser.StatusName, FallbackValue='No data available', TargetNullValue='No data available'}"
                    FontSize="18" FontFamily="{StaticResource Roboto}"
                    Foreground="White"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <Button
                Content="Profile"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Command="{Binding CommandProfile}" Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="2" HorizontalAlignment="Stretch"
                Margin="0,0,0,20"/>

            <Button
                Content="Management"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CommandManage}" Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="3" HorizontalAlignment="Stretch"
                Margin="0,0,0,20"/>

            <Button
                Content="Assign Grades"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding CanGrade, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CommandGrade}" Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="4" HorizontalAlignment="Stretch"
                Margin="0,0,0,20"/>

            <Button
                Content="View Grades"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding CanViewGrades, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CommandViewGrades}" Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="5" HorizontalAlignment="Stretch"/>

            <Button
                Content="Home"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding CanGoToHome, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CommandGoToHome}" 
                Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="7" HorizontalAlignment="Stretch"
                Margin="0,0,0,20"/>

            <Button
                Content="Log Out"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Command="{Binding CommandLogOut}" Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="White"
                Grid.Row="8" HorizontalAlignment="Stretch"
                Margin="0,0,0,10"/>
        </Grid>
    </Border>
</UserControl>