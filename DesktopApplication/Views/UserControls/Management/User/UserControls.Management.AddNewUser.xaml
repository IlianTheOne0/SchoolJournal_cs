<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementAddNewUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.UserControls"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Text="Add New User" 
            FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Roboto}"
            HorizontalAlignment="Center" Margin="0,0,0,20"
            Grid.ColumnSpan="2" Grid.Row="0"/>

        <StackPanel VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" Width="320" Margin="0,0,25,0">
            <TextBlock Text="User Name" Margin="5,5,5,0"/>
            <TextBox
                x:Name="NewUserUserNameTextBox"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Full Name" Margin="5,5,5,0"/>
            <TextBox
                x:Name="NewUserFullNameTextBox"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Email" Margin="5,15,5,0"/>
            <TextBox
                x:Name="NewUserEmailTextBox"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Password" Margin="5,15,5,0"/>
            <PasswordBox
                x:Name="NewUserPasswordTextBox"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Top" Grid.Column="1" Grid.Row="1" Margin="25,0,0,0" Width="320">
            <TextBlock Text="Phone Number"/>
            <TextBox
                x:Name="NewUserPhoneNumberTextBox"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Date of Birth" Margin="5,15,5,0"/>
            <DatePicker
                x:Name="NewUserDateOfBirthDatePicker"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Sex" Margin="5,15,5,0"/>
            <ComboBox
                x:Name="NewUserSexComboBox" 
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"
                SelectedIndex="0">
                <ComboBoxItem Tag="True">Male</ComboBoxItem>
                <ComboBoxItem Tag="False">Female</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="Status" Margin="5,15,5,0"/>
            <ComboBox
                x:Name="NewUserStatusCombobox"
                ItemsSource="{Binding AvailableStatuses}" 
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Status, FallbackValue='No data available', TargetNullValue='No data available'}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Button
            Content="Save" 
            Click="AddNewUser_Click"
            Width="300" Height="35" FontFamily="{StaticResource Roboto}"
            Style="{StaticResource MaterialDesignRaisedButton}"
            Margin="0,20,0,0"
            Grid.ColumnSpan="2" Grid.Row="2"/>
    </Grid>
</UserControl>