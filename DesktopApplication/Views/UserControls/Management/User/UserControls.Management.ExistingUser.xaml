<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementExistingUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.UserControls"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock
        Text="User" 
        FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Roboto}"
        HorizontalAlignment="Center" Margin="0,0,0,20"
        Grid.ColumnSpan="2" Grid.Row="0"/>

        <StackPanel VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" Width="320" Margin="0,0,25,0">
            <TextBlock Text="User Name" Margin="5,0,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.Username, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <TextBox
                    x:Name="NewUserUserNameTextBox"
                    Text="{Binding ChosenUser.Username, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
            </StackPanel>

            <TextBlock Text="Full Name" Margin="5,15,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.FullName, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <TextBox
                    x:Name="NewUserFullNameTextBox"
                    Text="{Binding ChosenUser.FullName, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
            </StackPanel>

            <TextBlock Text="Email" Margin="5,15,5,0"/>
            <TextBlock
                Text="{Binding ChosenUser.Email, FallbackValue='No data available', TargetNullValue='No data available'}"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Phone Number" Margin="5,15,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.PhoneNumber, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <TextBox
                    x:Name="NewUserPhoneNumberTextBox"
                    Text="{Binding ChosenUser.PhoneNumber, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel VerticalAlignment="Top" Grid.Column="1" Grid.Row="1" Margin="25,0,0,0" Width="320">
            <TextBlock Text="Date of the last visit to the journal" Margin="5,0,5,0"/>
            <TextBlock
                Text="{Binding ChosenUser.DateOfTheLastVisitToTheJournal, StringFormat='{}{0:MM/dd/yyyy}', FallbackValue='No data available', TargetNullValue='No data available'}"
                FontSize="16" FontFamily="{StaticResource Roboto}"
                Padding="5" Margin="5"/>

            <TextBlock Text="Date of Birth" Margin="5,15,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.DateOfBirth, StringFormat='{}{0:MM/dd/yyyy}', FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <DatePicker
                    x:Name="NewUserDateOfBirthDatePicker"
                    SelectedDate="{Binding ChosenUser.DateOfBirth}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
            </StackPanel>

            <TextBlock Text="Sex" Margin="5,15,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.Sex, FallbackValue='No data available', TargetNullValue='No data available', Converter={StaticResource BoolToGenderConverter}}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <ComboBox
                    x:Name="NewUserSexComboBox" 
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="5" Margin="5"
                    SelectedIndex="0">
                    <ComboBoxItem Tag="True">Male</ComboBoxItem>
                    <ComboBoxItem Tag="False">Female</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Status" Margin="5,15,5,0"/>
            <StackPanel>
                <TextBlock
                    Text="{Binding ChosenUser.StatusName, FallbackValue='No data available', TargetNullValue='No data available'}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Padding="5" Margin="5"/>
                <ComboBox
                    x:Name="NewUserStatusCombobox"
                    ItemsSource="{Binding AvailableStatuses, Mode=OneWay}" 
                    SelectedValue="{Binding ChosenUser.StatusId, Mode=OneWay}" SelectedValuePath="Id"
                    FontSize="16" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="5" Margin="5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,35,0,0" Width="500" Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Content="Edit"
                Width="200" Height="45"
                FontSize="20"  FontFamily="{StaticResource Roboto}"
                Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                Click="EditUser_Click"
                HorizontalAlignment="Left"
                Margin="0,0,25,0"/>
            <Button
                Grid.Column="2"
                Content="Delete"
                Width="200" Height="45"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right"
                Click="DeleteUser_Click"
                Margin="25,0,0,0"/>

            <Button
                Grid.Column="1"
                Content="Save changes"
                Width="200" Height="45"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Left"
                Click="SaveUser_Click"
                Margin="0,0,25,0"/>
            <Button
                Grid.Column="2"
                Content="Reset changes"
                Width="200" Height="45"
                FontSize="20" FontFamily="{StaticResource Roboto}"
                Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right"
                Click="ResetUser_Click"
                Margin="25,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
