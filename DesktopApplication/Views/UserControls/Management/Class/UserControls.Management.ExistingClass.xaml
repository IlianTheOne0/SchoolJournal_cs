<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementExistingClass"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.UserControls"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,35,25">
            <StackPanel>
                <TextBlock
                    Text="Class Name"
                    FontSize="20" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,50"/>

                <StackPanel
                    Width="250" Height="50"
                    HorizontalAlignment="Center"
                    Grid.Row="1"
                    Margin="0,0,0,75">
                    <TextBlock
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Name, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                    <TextBox
                        x:Name="NewClassNameTextBox"
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Name, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,75">
                <TextBlock
                    Text="Year of Studying"
                    FontSize="20" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,50"/>

                <StackPanel
                    Width="250" Height="50"
                    HorizontalAlignment="Center"
                    Grid.Row="1">
                    <TextBlock
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Year, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                    <TextBox
                        x:Name="NewClassYearTextBox"
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Year, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Grid Width="500" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Content="Edit"
                    Width="200" Height="45"
                    FontSize="20"  FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="EditClass_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,25,0"/>
                <Button
                    Grid.Column="2"
                    Content="Delete"
                    Width="200" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right"
                    Click="DeleteClass_Click"
                    Margin="25,0,0,0"/>

                <Button
                    Grid.Column="1"
                    Content="Save changes"
                    Width="200" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left"
                    Click="SaveClass_Click"
                    Margin="0,0,25,0"/>
                <Button
                    Grid.Column="2"
                    Content="Reset changes"
                    Width="200" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right"
                    Click="ResetClass_Click"
                    Margin="25,0,0,0"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" Margin="25,0,0,0">
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid 
                    ItemsSource="{Binding AvailableSubjects}" 
                    SelectedItem="{Binding ChosenSubject, Mode=TwoWay}" 
                    AutoGenerateColumns="False"
                    CanUserAddRows="False" 
                    CanUserDeleteRows="False"
                    IsReadOnly="{Binding IsEditingSubject, Converter={StaticResource InverseBooleanConverter}}"
                    Width="200"
                    FontSize="18"
                    Margin="0,0,0,75">
                    <DataGrid.Columns>
                        <DataGridTextColumn 
                        Header="Subject Name" 
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                        Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button
                        Content="Edit"
                        Width="120" Height="45"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding ChosenClass.Id, Converter={StaticResource NotAddNewOrNoneConverter}}"/>
                    <Button
                        Content="Delete"
                        Width="120" Height="45"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding ChosenClass.Id, Converter={StaticResource NotAddNewOrNoneConverter}}"/>
                    <Button
                        Content="Add"
                        Width="120" Height="45"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding IsEditing1, Converter={StaticResource InverseBooleanConverter}}"/>
                    <Button
                        Content="Save"
                        Width="120" Height="45"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding IsEditing1}"/>
                    <Button
                        Content="Cancel"
                        Width="120" Height="45"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding IsEditing1}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
