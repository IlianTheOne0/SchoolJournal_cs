<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementExistingClass"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.UserControls"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock
                    Text="Class Name"
                    FontSize="20" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,50"/>

                <StackPanel
                    Width="250" Height="50"
                    HorizontalAlignment="Center"
                    Grid.Row="1"
                    Margin="0,0,0,75">
                    <TextBlock
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Name, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                    <TextBox
                        x:Name="NewClassNameTextBox"
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Name, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,75">
                <TextBlock
                    Text="Year of Studying"
                    FontSize="20" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,50"/>

                <StackPanel
                    Width="250" Height="50"
                    HorizontalAlignment="Center"
                    Grid.Row="1">
                    <TextBlock
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Year, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                    <TextBox
                        x:Name="NewClassYearTextBox"
                        FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
                        Text="{Binding ChosenClass.Year, Mode=OneWay, FallbackValue='No data available', TargetNullValue='No data available'}"
                        Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}"
                        TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Grid Width="420" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Content="Edit"
                    Width="175" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="EditClass_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,25,0"/>
                <Button
                    Grid.Column="2"
                    Content="Delete"
                    Width="175" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right"
                    Click="DeleteClass_Click"
                    Margin="25,0,0,0"/>

                <Button
                    Grid.Column="1"
                    Content="Save changes"
                    Width="175" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Left"
                    Click="SaveClass_Click"
                    Margin="0,0,25,0"/>
                <Button
                    Grid.Column="2"
                    Content="Reset changes"
                    Width="175" Height="45"
                    FontSize="20" FontFamily="{StaticResource Roboto}"
                    Visibility="{Binding IsEditing0, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right"
                    Click="ResetClass_Click"
                    Margin="25,0,0,0"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" Margin="15,0,0,0">
            <StackPanel>
                <DataGrid
                    x:Name="SubjectsDataGrid"
                    MinHeight="356" MaxWidth="365"
                    ItemsSource="{Binding AvailableSubjects}"
                    SelectedItem="{Binding ChosenSubject, Mode=TwoWay}" 
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    IsReadOnly="True"
                    FontSize="18" FontFamily="{StaticResource Roboto}"
                    Margin="0,0,0,25">
                    <DataGrid.Columns>
                        <DataGridTextColumn 
                            Header="Subject Name" 
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Width="*"/>
                        <DataGridTextColumn 
                            Header="Teacher Name" 
                            Binding="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" 
                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0"
                    Visibility="{Binding IsEditing1, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button
                        Content="Edit"
                        Width="150" Height="45"
                        Margin="0,0,30,0"
                        FontSize="20" FontFamily="{StaticResource Roboto}"
                        Click="EditSubject_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button
                        Content="Delete"
                        Width="150" Height="45"
                        Margin="30,0,0,0"
                        FontSize="20" FontFamily="{StaticResource Roboto}"
                        Click="DeleteSubject_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,15,0,0"
                    Visibility="{Binding IsEditing1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="16" FontFamily="{StaticResource Roboto}" Text="Subject Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox FontSize="16" FontFamily="{StaticResource Roboto}" Text="{Binding ChosenSubject.Name, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,15,0,0"
                    Visibility="{Binding IsEditing1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="16" FontFamily="{StaticResource Roboto}" Text="Assign Teacher:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox
                        Width="250"
                        ItemsSource="{Binding AvailableTeachers}"
                        DisplayMemberPath="FullName"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding ChosenSubject.TeacherId}"
                        FontSize="16" FontFamily="{StaticResource Roboto}"/>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"
                    Visibility="{Binding IsEditing1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button
                        Content="Add"
                        Width="150" Height="45"
                        Margin="0,0,30,0"
                        FontSize="20" FontFamily="{StaticResource Roboto}"
                        Click="AddSubject_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button
                        Content="Cancel"
                        Width="150" Height="45"
                        Margin="30,0,0,0"
                        FontSize="20" FontFamily="{StaticResource Roboto}"
                        Click="CancelSubject_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
