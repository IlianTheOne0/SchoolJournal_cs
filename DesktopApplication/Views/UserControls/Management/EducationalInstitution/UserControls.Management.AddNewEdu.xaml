<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementAddNewEdu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.Pages"
             mc:Ignorable="d" 
             MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Educational Institution Name"
            FontSize="20" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
            HorizontalAlignment="Center"
            Grid.Row="0"
            Margin="0,0,0,50"/>
        <TextBox
            Width="350" Height="50"
            FontSize="32" FontWeight="Medium" FontFamily="{StaticResource Roboto}"
            TextAlignment="Center" HorizontalAlignment="Center"
            Grid.Row="1"
            Margin="0,0,0,75"/>

        <Button
            Content="Create"
            Width="200" Height="45"
            FontSize="20"  FontFamily="{StaticResource Roboto}"
            Style="{StaticResource MaterialDesignRaisedButton}"
            HorizontalAlignment="Center"
            Grid.Row="2"/>
    </Grid>
</UserControl>
