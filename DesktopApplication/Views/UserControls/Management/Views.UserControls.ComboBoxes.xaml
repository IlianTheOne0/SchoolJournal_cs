<UserControl x:Class="DesktopApplication.Views.UserControls.UserControlsManagementComboBoxes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:DesktopApplication.Views.UserControls"
        mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Management"
            FontSize="24" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
            VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,50,0,0"/>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="5,100,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock
                    Text="Educational Institutions"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <ComboBox
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    DisplayMemberPath="Name" SelectedItem="{Binding ChosenEdu}" ItemsSource="{Binding AvailableEdu}"
                    Margin="5"/>

                <TextBlock
                    Text="Class:"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="30,0,5,0"/>
                <ComboBox
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    DisplayMemberPath="Name" SelectedItem="{Binding ChosenClass}" ItemsSource="{Binding AvailableClasses}"
                    IsEnabled="{Binding IsChosenEdu}"
                    Margin="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock
                    Text="User:"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="30,0,5,0"/>
                <ComboBox
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    DisplayMemberPath="FullName" SelectedItem="{Binding ChosenUser}" ItemsSource="{Binding AvailableUsersWithNone}"
                    IsEnabled="{Binding IsChosenEdu}"
                    Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>