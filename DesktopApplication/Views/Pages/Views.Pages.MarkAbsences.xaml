<UserControl x:Class="DesktopApplication.Views.Pages.PagesMarkAbsences"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.Pages"
             mc:Ignorable="d" 
             MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="SidebarHost" Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource MaterialDesignDarkSeparatorBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Mark Absences"
                FontSize="24" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,50,0,0"/>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="5,100,5,5">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Text="Class:"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"/>
                    <ComboBox
                        x:Name="ClassComboBox"
                        Width="165"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        DisplayMemberPath="Name" SelectedItem="{Binding ChosenClass}" ItemsSource="{Binding AvailableClasses}"
                        Margin="5"/>

                    <TextBlock
                        Text="Subject:"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="SubjectComboBox"
                        Width="165"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        DisplayMemberPath="Name" SelectedItem="{Binding ChosenSubject}" ItemsSource="{Binding AvailableSubjects}"
                        Margin="5"/>

                    <TextBlock
                        Text="Month:"
                        FontSize="16" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="MonthComboBox"
                        Width="100"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        SelectedItem="{Binding ChosenMonth}" ItemsSource="{Binding AvailableMonths}"/>

                    <TextBlock
                        Text="Year:"
                        FontSize="16" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="YearComboBox"
                        Width="80"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        SelectedItem="{Binding ChosenYear}" ItemsSource="{Binding AvailableYears}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Margin="5">
                <DataGrid
                    x:Name="AbsencesDataGrid"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding AvailableAbsences}"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                    GridLinesVisibility="All" HeadersVisibility="All"
                    FontSize="12" FontFamily="{StaticResource Roboto}">
                    <DataGrid.Resources>
                        <Style x:Key="StudentNameCellStyle" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{StaticResource MaterialDesignDarkSeparatorBackground}"/>
                            <Setter Property="FontWeight" Value="Medium"/>

                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Style.Resources>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Style.Resources>
                        </Style>

                        <Style x:Key="AbsencesCellStyle" TargetType="DataGridCell">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Cursor" Value="Hand"/>

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource MaterialDesignShadowBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Student"
                            Binding="{Binding StudentName}"
                            Width="200"
                            IsReadOnly="True"
                            CellStyle="{StaticResource StudentNameCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
