<UserControl x:Class="DesktopApplication.Views.Pages.PagesGradeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApplication.Views.Pages"
             xmlns:converter="clr-namespace:DesktopApplication.Services.Converters"
             mc:Ignorable="d" 
             MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="SidebarHost" Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource MaterialDesignDarkSeparatorBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Grades"
                FontSize="24" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,50,0,0"/>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Visibility="{Binding IsTeacherMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="5,100,5,5">
                <TextBlock
                    Text="Class:"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <ComboBox
                    x:Name="ClassComboBox" 
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    ItemsSource="{Binding AvailableClasses}" 
                    DisplayMemberPath="ClassName"
                    SelectedItem="{Binding SelectedClass}"
                    SelectionChanged="ClassComboBox_SelectionChanged"
                    Margin="5"/>
                    
                <TextBlock
                    Text="Student:"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="30,0,5,0"/>
                <ComboBox
                    x:Name="StudentComboBox"
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    ItemsSource="{Binding StudentsInClass}" 
                    DisplayMemberPath="FullName"
                    SelectedItem="{Binding SelectedStudent}"
                    SelectionChanged="StudentComboBox_SelectionChanged"
                    IsEnabled="{Binding HasClassSelected}"
                    Margin="5"/>
                    
                <TextBlock
                    Text="Subject:"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    VerticalAlignment="Center"
                    Margin="30,0,5,0"/>
                <ComboBox
                    x:Name="SubjectComboBox"
                    ItemsSource="{Binding AvailableSubjects}" 
                    Width="165"
                    FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                    SelectedItem="{Binding SelectedSubject}"
                    SelectionChanged="SubjectComboBox_SelectionChanged"
                    DisplayMemberPath="Name"
                    Margin="5"/>
            </StackPanel>

            <DataGrid
                x:Name="GradesDataGrid"
                Grid.Row="2"
                ItemsSource="{Binding FilteredGrades}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject" Binding="{Binding SubjectName}" Width="200"/>
                    <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="200"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="200"/>
                    <DataGridTextColumn Header="Comment" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>