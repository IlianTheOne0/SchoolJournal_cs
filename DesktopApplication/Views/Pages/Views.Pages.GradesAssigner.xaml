<UserControl x:Class="DesktopApplication.Views.Pages.PagesGradesAssigner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApplication.Views.Pages"
        mc:Ignorable="d"
        MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ContentControl x:Name="SidebarHost" Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource MaterialDesignDarkSeparatorBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Assign Grades"
                FontSize="24" FontWeight="Heavy" FontFamily="{StaticResource Roboto}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,50,0,0"/>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="5,100,5,5">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Text="Class:"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"/>
                    <ComboBox
                        x:Name="ClassComboBox"
                        Width="165"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        DisplayMemberPath="Name" SelectedItem="{Binding ChosenClass}" ItemsSource="{Binding AvailableClasses}"
                        Margin="5"/>

                    <TextBlock
                        Text="Subject:"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="SubjectComboBox"
                        Width="165"
                        FontSize="18" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        DisplayMemberPath="Name" SelectedItem="{Binding ChosenSubject}" ItemsSource="{Binding AvailableSubjects}"
                        Margin="5"/>

                    <TextBlock
                        Text="Month:"
                        FontSize="16" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="MonthComboBox"
                        Width="100"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        SelectedItem="{Binding ChosenMonth}" ItemsSource="{Binding AvailableMonths}"/>

                    <TextBlock
                        Text="Year:"
                        FontSize="16" FontWeight="Normal" FontFamily="{StaticResource Roboto}"
                        VerticalAlignment="Center"
                        Margin="30,0,5,0"/>
                    <ComboBox
                        x:Name="YearComboBox"
                        Width="80"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        SelectedItem="{Binding ChosenYear}" ItemsSource="{Binding AvailableYears}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Margin="5">
                <DataGrid
                    x:Name="GradesDataGrid"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding AvailableGrades}"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                    GridLinesVisibility="All" HeadersVisibility="All"
                    FontSize="12" FontFamily="{StaticResource Roboto}"
                    PreviewMouseLeftButtonDown="GradesDataGrid_PreviewMouseLeftButtonDown">
                    <DataGrid.Resources>
                        <Style x:Key="StudentNameCellStyle" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{StaticResource MaterialDesignDarkSeparatorBackground}"/>
                            <Setter Property="FontWeight" Value="Medium"/>

                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Style.Resources>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Style.Resources>
                        </Style>

                        <Style x:Key="GradeCellStyle" TargetType="DataGridCell">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Cursor" Value="Hand"/>

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource MaterialDesignShadowBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Student"
                            Binding="{Binding StudentName}"
                            Width="200"
                            IsReadOnly="True"
                            CellStyle="{StaticResource StudentNameCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="GradeEntryOverlay"
              Grid.Column="1"
              Visibility="Collapsed">

            <StackPanel Background="Black" Opacity="0.25"/>

            <Border CornerRadius="25" Background="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="400" Height="495" Margin="30">
                    <TextBlock
                        Text="Enter Grade"
                        FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Roboto}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"/>
                    <TextBlock 
                        x:Name="StudentDateInfo"
                        Text="Student: [Name] | Date: [Date]"
                        FontSize="14"
                        FontFamily="{StaticResource Roboto}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"
                        Foreground="{StaticResource MaterialDesignBodyLight}"/>

                    <TextBlock
                        Text="Select Grade (1-12):"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Margin="0,0,0,10"/>
                    <UniformGrid
                        x:Name="GradeButtons"
                        Rows="2" Columns="6"
                        Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Button
                            Content="Absent"
                            Width="170" Height="35"
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Click="AbsentButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,15,0"/>
                        <Button
                            Content="Sick"
                            Width="170" Height="35"
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Click="SickButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,15,0"/>
                    </StackPanel>

                    <CheckBox
                        x:Name="CustomGradeCheckBox"
                        Content="Enter the custom grade"
                        FontSize="14"
                        Margin="0,0,0,10"
                        Checked="CustomGradeCheckBox_Checked"
                        Unchecked="CustomGradeCheckBox_Unchecked"/>
                    <TextBox
                        x:Name="CustomGradeTextBox"
                        Width="100" Height="35"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Margin="0,0,0,20"
                        IsEnabled="False"/>

                    <TextBlock
                        Text="Comment (optional, max 256 characters)"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        Margin="0,0,0,5"/>
                    <TextBox
                        x:Name="CommentTextBox"
                        Height="60"
                        FontSize="16" FontFamily="{StaticResource Roboto}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxLength="256"
                        Margin="0,0,0,25"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button
                            Content="Save"
                            Width="100" Height="35"
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Click="SaveGradeButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,15,0"/>
                        <Button
                            Content="Delete"
                            Width="100" Height="35"
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Click="DeleteGradeButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5,0,5,0"/>
                        <Button
                            Content="Cancel"
                            Width="100" Height="35"
                            FontSize="16" FontFamily="{StaticResource Roboto}"
                            Click="CancelGradeButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="15,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>